# Example of /opt/platform/.env. The real file is rendered on the server by
# .github/workflows/deploy-platform.yml from GitHub Secrets/Variables.
# Never commit a real .env (it is gitignored).

# --- always ---
DOMAIN=karan-s.com
ACME_EMAIL=you@example.com
CF_DNS_API_TOKEN=<cloudflare token: Zone Read + DNS Edit on karan-s.com>
# Set by the deploy workflow after cosign verification:
CADDY_IMAGE=ghcr.io/karan-sss/caddy-cloudflare@sha256:<digest>
# Comma-separated Compose profiles: "" (Caddy only), "data", "data,ops"
COMPOSE_PROFILES=

# --- profile: data (Postgres, Redis, Sablier) ---
PROJECTS=portfolio
PG_SUPERUSER_PASSWORD=<openssl rand -base64 32>
PG_RO_PASSWORD=<openssl rand -base64 32>
PG_PASS_PORTFOLIO=<openssl rand -base64 32>
REDIS_ADMIN_PASSWORD=<openssl rand -base64 32>
REDIS_PASS_PORTFOLIO=<openssl rand -base64 32>

# --- profile: ops (Grafana Alloy -> Grafana Cloud) ---
GRAFANA_CLOUD_TOKEN=<access policy token: metrics:write, logs:write>
GRAFANA_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GRAFANA_PROM_USER=<numeric id>
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=<numeric id>

# backup/.env (separate file, mode 600) holds RESTIC_REPOSITORY, RESTIC_PASSWORD,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (R2 backups key) and HC_PING_KEY.
