#cloud-config
# Rendered by Terraform (hetzner.tf). Runs ONCE on first boot.
# Changes here only affect newly built servers (ignore_changes on user_data).

hostname: ${hostname}
timezone: Etc/UTC

groups:
  - docker

users:
  - name: ${admin_username}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    # Password works on the Hetzner web console only (SSH password auth is off).
    lock_passwd: false
    hashed_passwd: "${admin_password_hash}"
    ssh_authorized_keys:
      - "${admin_ssh_pubkey}"
  - name: deployer
    groups: [docker]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - "${deploy_ssh_pubkey}"

disable_root: true
ssh_pwauth: false

swap:
  filename: /swapfile
  size: 4G
  maxsize: 4G

apt:
  sources:
    docker.list:
      source: "deb [arch=arm64 signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      key: |
        ${indent(8, docker_apt_key)}
    tailscale.list:
      source: "deb [signed-by=$KEY_FILE] https://pkgs.tailscale.com/stable/ubuntu $RELEASE main"
      key: |
        ${indent(8, tailscale_apt_key)}

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - ufw
  - fail2ban
  - unattended-upgrades
  - needrestart
  - rsync
  - jq
  - restic
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-buildx-plugin
  - docker-compose-plugin
  - tailscale

write_files:
  - path: /etc/sysctl.d/99-platform.conf
    content: |
      vm.swappiness = 10
      vm.vfs_cache_pressure = 50
      net.ipv4.ip_forward = 1
      net.ipv6.conf.all.forwarding = 1

  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      X11Forwarding no
      MaxAuthTries 3
      AllowUsers ${admin_username} deployer

  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" },
        "live-restore": true
      }

  - path: /etc/fail2ban/jail.local
    content: |
      [sshd]
      enabled  = true
      maxretry = 5
      bantime  = 1h

  - path: /etc/systemd/journald.conf.d/size.conf
    content: |
      [Journal]
      SystemMaxUse=200M

  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:30";

  # Stop containers from reading cloud-init user data (and its secrets)
  # from the Hetzner metadata service. Re-applied whenever Docker restarts.
  - path: /etc/systemd/system/block-metadata.service
    content: |
      [Unit]
      Description=Block container access to the cloud metadata service
      After=docker.service
      PartOf=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.169.254/32 -j REJECT 2>/dev/null || iptables -I DOCKER-USER -d 169.254.169.254/32 -j REJECT'

      [Install]
      WantedBy=docker.service

  - path: /etc/systemd/system/heartbeat.service
    content: |
      [Unit]
      Description=healthchecks.io server heartbeat
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/${hc_ping_key}/server-heartbeat

  - path: /etc/systemd/system/heartbeat.timer
    content: |
      [Unit]
      Description=Ping healthchecks.io every 5 minutes

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=5min

      [Install]
      WantedBy=timers.target

  # Backup units are installed now; they stay inactive until the platform
  # deploy puts backup.sh in place (Task 13).
  - path: /etc/systemd/system/backup.service
    content: |
      [Unit]
      Description=Nightly restic backup to R2
      ConditionPathExists=/opt/platform/backup/backup.sh
      Wants=network-online.target
      After=network-online.target docker.service

      [Service]
      Type=oneshot
      User=deployer
      EnvironmentFile=/opt/platform/backup/.env
      ExecStart=/opt/platform/backup/backup.sh

  - path: /etc/systemd/system/backup.timer
    content: |
      [Unit]
      Description=Run backup nightly

      [Timer]
      OnCalendar=*-*-* 03:00
      RandomizedDelaySec=15m
      Persistent=true

      [Install]
      WantedBy=timers.target

runcmd:
  - sysctl --system
  - systemctl daemon-reload
  - tailscale up --authkey="${ts_authkey}" --hostname=${hostname} --advertise-tags=tag:server
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 41641/udp
  - ufw allow in on tailscale0 to any port 22 proto tcp
  - ufw --force enable
  - systemctl restart docker
  - systemctl enable --now block-metadata.service fail2ban heartbeat.timer backup.timer
  - systemctl restart ssh
  - install -d -o deployer -g deployer -m 750 /opt/platform /opt/apps
  - docker network inspect edge >/dev/null 2>&1 || docker network create edge

final_message: "cloud-init finished after $UPTIME seconds"
